FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app
COPY local/requirements.lock /app/local/requirements.lock
RUN python -m pip install --no-cache-dir --disable-pip-version-check -r /app/local/requirements.lock
COPY local/harness /app/local/harness
COPY local/tests /app/local/tests
COPY evaluator /app/evaluator
RUN useradd --uid 65532 --create-home --shell /usr/sbin/nologin harness \
    && chmod -R a-w /app

USER 65532:65532
WORKDIR /workspace
ENTRYPOINT ["python", "-m", "local.harness.controller"]

